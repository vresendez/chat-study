POE_API_KEY=paste_your_poe_key_here
SECRET_KEY=generate_with_python_secrets_token_hex_32
ADMIN_TOKEN=generate_with_python_secrets_token_hex_16
DAILY_LIMIT=100
# set to 1 once the site is served over https
HTTPS_ONLY=0

# --- Optional: hosted Postgres (leave empty to use the local study.db file) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Optional: accept participants automatically from LimeSurvey ---
# Needs "RPC interface" enabled in LimeSurvey (Global settings > Interfaces: JSON-RPC)
# LS_RPC_URL=https://your-limesurvey.example.edu/index.php/admin/remotecontrol
# LS_USER=api_user
# LS_PASSWORD=api_password
# LS_SURVEY_ID=123456
